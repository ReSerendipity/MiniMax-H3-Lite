# MM·H3 工作台 环境变量模板
# 用法：复制为 .env 后按需填写；本文件仅列字段名，不含任何真实值。
# 配置优先级：环境变量 > backend/config.py 默认值（见 Settings.from_env）。

# ── 服务 ──────────────────────────────────────────────
# 服务地址（安全强制：仅允许回环地址 127.0.0.1 / localhost / ::1，禁止 0.0.0.0）
MMH3_HOST=127.0.0.1
MMH3_PORT=18080

# ── 推理 ──────────────────────────────────────────────
# 本地权重路径；留空则从 HF / 魔搭拉取
# MMH3_MODEL_PATH=
# 推理后端：diffusers | comfy（进程内复用 ComfyUI 内核）
MMH3_INFERENCE_BACKEND=diffusers
# 量化：bf16 | int8 | int4 | gguf-q4_k_m
MMH3_QUANTIZATION=int8
# 并发数（单机默认串行）
MMH3_MAX_CONCURRENCY=1

# ── ComfyUI（B 方案，可选）──────────────────────────
# MMH3_COMFY_SOURCE_DIR=
# MMH3_COMFY_URL=http://127.0.0.1:8188

# ── 官方 H3 模型文件名（一般无需覆盖，缺省取自 h3.spec）──
# MMH3_MODEL_FL2VA=
# MMH3_MODEL_REF2VA=
# MMH3_MODEL_CLIP=
# MMH3_MODEL_VAE_VIDEO=
# MMH3_MODEL_VAE_AUDIO=

# ── 安全 ──────────────────────────────────────────────
# 代码完整性自检：启动时校验完整性清单 + Ed25519 签名，失败拒绝启动（fail-closed）
MMH3_INTEGRITY_ENFORCE=true
# 水印嵌入失败策略：false=侧车档（写 .provenance.json 后放行，默认）；true=阻断产出
MMH3_WATERMARK_FAIL_BLOCK=false
# 水印 / 来源标识签名密钥（敏感！请勿提交真实值；不设置则来源标识降级为无签名侧车档）
# MMH3_SIGN_KEY=
