#!/bin/sh
# pre-push hook: 本地预检拦截（家族治理 2026-08-28）
# 跳过一次: git push --no-verify（仅限用户明确要求）
echo "[pre-push] running local precheck..."
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "./precheck.ps1"
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "[pre-push] PRECHECK FAILED (exit $status) - push REJECTED."
  echo "  Fix the issues and push again. (git push --no-verify to skip once, not recommended)"
  exit 1
fi
echo "[pre-push] precheck passed - push allowed."
exit 0